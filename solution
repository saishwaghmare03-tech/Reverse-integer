class Solution {
    public int reverse(int x) {
        int rev = 0;

        while (x != 0) {
            int digit = x % 10;
            x = x / 10;

            if (rev > Integer.MAX_VALUE / 10 ||
                (rev == Integer.MAX_VALUE / 10 && digit > 7)) {
                return 0;
            }

            if (rev < Integer.MIN_VALUE / 10 ||
                (rev == Integer.MIN_VALUE / 10 && digit < -8)) {
                return 0;
            }

            rev = rev * 10 + digit;
        }

        return rev;
    }

    public static void main(String[] args) {
        Solution solution = new Solution();

        // Test cases
        int test1 = 123;
        int test2 = -123;
        int test3 = 120;

        System.out.println("Input: " + test1 + " -> Output: " + solution.reverse(test1)); // Expected: 321
        System.out.println("Input: " + test2 + " -> Output: " + solution.reverse(test2)); // Expected: -321
        System.out.println("Input: " + test3 + " -> Output: " + solution.reverse(test3)); // Expected: 21
    }
}
